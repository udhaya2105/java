import java.util.*;
public class Specialtwodigits{
public static void main(String[] args)
{
Scanner sc=new Scanner(System.in);
System.out.println("Enter the value");
int n=sc.nextInt();
int sum=0;
int product=1;
int temp=n;
while(n!=0)
{
int digit=n%10;
sum=sum+digit;
product=product*digit;
n=n/10;
}
int res=sum+product;
if(res==n)
{
System.out.println("special two digits");
}
else
	{
	System.out.println(" Not a special two digits");
	
}
}
}

