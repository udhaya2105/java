import java.util.*;
public class duck
{
public static void main(String[] args)
{
Scanner sc=new Scanner(System.in);
System.out.println("Enter a number");
int n=sc.nextInt()
while(n!=0)
{
int last=n%10;
if(last==0)
{
System.out.println("duck number");
}
n/=10;
}
System.out.println("Not a duck number");
}
}