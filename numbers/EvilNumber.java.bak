import java.util.Scanner;
class EvilNumber
{
public static void main(String[] args)
{
Scanner sc=new Scanner(System.in);
System.out.print("Enter a number: ");
int n=sc.nextInt();
int count=0;
while(n!=0)
{
int last=n%2;
if(last==1)
{
count++;
}
n=n/2;
}
if(count%2==0)
{
System.out.println("Evil Number");
}
else
{
System.out.println("Not an Evil Number");
}
}
}